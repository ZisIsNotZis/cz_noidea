    "from asyncio import start_server\n",
    "async def _(i, o):\n",
    "    await i.read(9999)\n",
    "    o.write(b'HTTP/1.0 200 OK\\r\\n\\r\\nHELLO WORLD')\n",
    "    o.close()\n",
    "await start_server(_, '0.0.0.0', 9999)"
   ]
  }
