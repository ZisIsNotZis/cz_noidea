    "from asyncio import open_connection\n",
    "_,o = await open_connection('localhost', 9999)\n",
    "a = bytes(262144)\n",
    "for _ in range(99999):\n",
    "    o.write(a)\n",
    "    await o.drain()\n",
    "o.close()"
